{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# Вебинар 2: Применение регрессии и классификации в финтех задачах\n",
    "\n",
    "## 📊 Датасет\n",
    "**Название:** [Home Credit Default Risk](https://www.kaggle.com/c/home-credit-default-risk)  \n",
    "**Описание:** Датасет от Home Credit Group — данные о кредитных заявках с дополнительной информацией из бюро кредитных историй, предыдущих заявок и т.д.  \n",
    "**Размер:** ~307k заявок, 122 признака (после merge).  \n",
    "**Задача:** Предсказание дефолта по кредиту + регрессия суммы кредита.  \n",
    "**Бизнес-применение:** Многоуровневая скоринговая модель, оценка рисков.\n",
    "\n",
    "## 🎯 Цели ноутбука\n",
    "1. Объединить несколько связанных таблиц (bureau, previous_application)\n",
    "2. Построить регрессионную модель для предсказания суммы кредита\n",
    "3. Построить классификатор дефолта с ROC-AUC > 0.72\n",
    "4. Рассчитать бизнес-стоимость ошибок при разных порогах"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Импорт библиотек и загрузка данных"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.preprocessing import StandardScaler, LabelEncoder\n",
    "from sklearn.linear_model import Ridge, Lasso, LogisticRegression\n",
    "from sklearn.ensemble import RandomForestRegressor, GradientBoostingClassifier, GradientBoostingRegressor\n",
    "from sklearn.metrics import (\n",
    "    roc_auc_score, mean_absolute_error, mean_squared_error, r2_score,\n",
    "    classification_report, confusion_matrix\n",
    ")\n",
    "import os\n",
    "\n",
    "# Kaggle competition: /kaggle/input/home-credit-default-risk\n",
    "for dirname, _, filenames in os.walk('/kaggle/input'):\n",
    "    for filename in filenames:\n",
    "        print(os.path.join(dirname, filename))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Загружаем основные таблицы\n",
    "DATA_PATH = '/kaggle/input/home-credit-default-risk'\n",
    "\n",
    "app_train = pd.read_csv(f'{DATA_PATH}/application_train.csv')\n",
    "app_test = pd.read_csv(f'{DATA_PATH}/application_test.csv')\n",
    "bureau = pd.read_csv(f'{DATA_PATH}/bureau.csv')\n",
    "bureau_balance = pd.read_csv(f'{DATA_PATH}/bureau_balance.csv')\n",
    "previous = pd.read_csv(f'{DATA_PATH}/previous_application.csv')\n",
    "\n",
    "print(f\"application_train: {app_train.shape}\")\n",
    "print(f\"bureau: {bureau.shape}\")\n",
    "print(f\"bureau_balance: {bureau_balance.shape}\")\n",
    "print(f\"previous_application: {previous.shape}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. EDA — Базовая таблица заявок"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "print(f\"TARGET: дефолт = 1, платящий = 0\")\n",
    "print(f\"\\nРаспределение TARGET:\")\n",
    "print(app_train['TARGET'].value_counts())\n",
    "print(f\"\\nДоля дефолтов: {app_train['TARGET'].mean():.2%}\")\n",
    "\n",
    "# Основные колонки\n",
    "print(f\"\\nКолонки ({len(app_train.columns)}):\")\n",
    "print(list(app_train.columns[:30]))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Анализ пропусков\n",
    "missing = app_train.isna().sum().sort_values(ascending=False)\n",
    "missing_pct = (missing / len(app_train) * 100).round(1)\n",
    "missing_df = pd.DataFrame({'count': missing, 'pct': missing_pct})\n",
    "print(\"Топ-15 признаков с пропусками:\")\n",
    "print(missing_df.head(15))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Feature Engineering: объединяем таблицы"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Агрегация bureau (кредитная история в бюро) ===\n",
    "bureau_agg = bureau.groupby('SK_ID_CURR').agg({\n",
    "    'SK_ID_BUREAU': 'count',\n",
    "    'DAYS_CREDIT': ['min', 'max', 'mean'],\n",
    "    'CREDIT_DAY_OVERDUE': ['max', 'mean', 'sum'],\n",
    "    'AMT_CREDIT_SUM': ['sum', 'mean', 'max'],\n",
    "    'AMT_CREDIT_SUM_DEBT': ['sum', 'mean'],\n",
    "    'AMT_CREDIT_SUM_OVERDUE': ['max', 'sum'],\n",
    "    'CREDIT_ACTIVE': lambda x: (x == 'Active').sum(),\n",
    "}).reset_index()\n",
    "\n",
    "bureau_agg.columns = ['SK_ID_CURR'] + [\n",
    "    f'bureau_{col[0]}_{col[1]}' for col in bureau_agg.columns[1:]\n",
    "]\n",
    "\n",
    "print(f\"Bureau агрегаты: {bureau_agg.shape}\")\n",
    "bureau_agg.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Агрегация previous_application ===\n",
    "prev_agg = previous.groupby('SK_ID_CURR').agg({\n",
    "    'SK_ID_PREV': 'count',\n",
    "    'AMT_ANNUITY': ['mean', 'sum'],\n",
    "    'AMT_APPLICATION': ['mean', 'max'],\n",
    "    'AMT_CREDIT': ['mean', 'sum'],\n",
    "    'AMT_DOWN_PAYMENT': ['mean', 'sum'],\n",
    "    'DAYS_DECISION': ['min', 'max', 'mean'],\n",
    "    'CNT_PAYMENT': ['mean', 'sum'],\n",
    "    'NAME_CONTRACT_STATUS': lambda x: (x == 'Approved').sum(),\n",
    "    'NAME_CONTRACT_STATUS': lambda x: (x == 'Refused').sum(),\n",
    "}).reset_index()\n",
    "\n",
    "# Из-за дублирования лямбды переименуем аккуратно\n",
    "prev_agg = previous.groupby('SK_ID_CURR').agg(\n",
    "    prev_count=('SK_ID_PREV', 'count'),\n",
    "    prev_annuity_mean=('AMT_ANNUITY', 'mean'),\n",
    "    prev_application_mean=('AMT_APPLICATION', 'mean'),\n",
    "    prev_application_max=('AMT_APPLICATION', 'max'),\n",
    "    prev_credit_mean=('AMT_CREDIT', 'mean'),\n",
    "    prev_credit_sum=('AMT_CREDIT', 'sum'),\n",
    "    prev_down_payment_sum=('AMT_DOWN_PAYMENT', 'sum'),\n",
    "    prev_days_decision_min=('DAYS_DECISION', 'min'),\n",
    "    prev_days_decision_max=('DAYS_DECISION', 'max'),\n",
    "    prev_cnt_payment_mean=('CNT_PAYMENT', 'mean'),\n",
    "    prev_approved=('NAME_CONTRACT_STATUS', lambda x: (x == 'Approved').sum()),\n",
    "    prev_refused=('NAME_CONTRACT_STATUS', lambda x: (x == 'Refused').sum()),\n",
    ").reset_index()\n",
    "\n",
    "print(f\"Previous агрегаты: {prev_agg.shape}\")\n",
    "prev_agg.head()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Объединяем всё в одну таблицу ===\n",
    "df = app_train.merge(bureau_agg, on='SK_ID_CURR', how='left')\n",
    "df = df.merge(prev_agg, on='SK_ID_CURR', how='left')\n",
    "\n",
    "print(f\"Итого признаков: {df.shape[1]}\")\n",
    "print(f\"Итого строк: {df.shape[0]}\")\n",
    "\n",
    # Добавляем простые признаки
    "df['CREDIT_INCOME_RATIO'] = df['AMT_CREDIT'] / (df['AMT_INCOME_TOTAL'] + 1)\n",
    "df['ANNUITY_INCOME_RATIO'] = df['AMT_ANNUITY'] / (df['AMT_INCOME_TOTAL'] + 1)\n",
    "df['CREDIT_TERM'] = df['AMT_ANNUITY'] / (df['AMT_CREDIT'] + 1)\n",
    "df['DAYS_EMPLOYED_RATIO'] = df['DAYS_EMPLOYED'] / (df['DAYS_BIRTH'] + 1)\n",
    "\n",
    "print(f\"\\nПосле feature engineering: {df.shape[1]} признаков\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Подготовка данных для моделей"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Обработка категориальных признаков ===\n",
    "# Label Encoding для бинарных, One-Hot для многозначных\n",
    "df_processed = df.copy()\n",
    "\n",
    "# Бинарные категориальные (yes/no) -> 1/0\n",
    "binary_cols = []\n",
    "for col in df_processed.columns:\n",
    "    if df_processed[col].dtype == 'object':\n",
    "        unique_vals = df_processed[col].dropna().unique()\n",
    "        if len(unique_vals) == 2:\n",
    "            binary_cols.append(col)\n",
    "            df_processed[col] = (df_processed[col] == unique_vals[0]).astype(int)\n",
    "\n",
    "print(f\"Бинарные колонки: {len(binary_cols)}\")\n",
    "\n",
    "# Остальные категориальные -> One-Hot\n",
    "cat_cols = [c for c in df_processed.columns if df_processed[c].dtype == 'object']\n",
    "print(f\"Категориальных к one-hot: {len(cat_cols)}\")\n",
    "\n",
    "df_processed = pd.get_dummies(df_processed, columns=cat_cols, dummy_na=True)\n",
    "print(f\"После one-hot: {df_processed.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Заполнение пропусков и удаление нечисловых колонок ===\n",
    "non_numeric = df_processed.select_dtypes(exclude=[np.number]).columns.tolist()\n",
    "print(f\"Нечисловых: {non_numeric}\")\n",
    "\n",
    "for col in non_numeric:\n",
    "    df_processed[col] = pd.to_numeric(df_processed[col], errors='coerce')\n",
    "\n",
    "# Заполняем пропуски медианой\n",
    "for col in df_processed.columns:\n",
    "    if col not in ['TARGET', 'SK_ID_CURR'] and df_processed[col].isna().any():\n",
    "        df_processed[col] = df_processed[col].fillna(df_processed[col].median())\n",
    "\n",
    "print(f\"Осталось пропусков: {df_processed.isna().sum().sum()}\")\n",
    "print(f\"Финальный размер: {df_processed.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Подготовка X и y ===\n",
    "drop_cols = ['TARGET', 'SK_ID_CURR']\n",
    "X = df_processed.drop(columns=drop_cols, errors='ignore').values\n",
    "y_class = df_processed['TARGET'].values\n",
    "y_reg = df_processed['AMT_CREDIT'].values  # Регрессия: сумма кредита\n",
    "\n",
    "print(f\"X: {X.shape}\")\n",
    "print(f\"y_class: баланс = {y_class.mean():.2%}\")\n",
    "print(f\"y_reg: среднее = {y_reg.mean():,.0f}, медиана = {np.median(y_reg):,.0f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Задача регрессии: предсказание суммы кредита"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "X_train, X_test, y_train_r, y_test_r = train_test_split(\n",
    "    X, y_reg, test_size=0.25, random_state=42\n",
    ")\n",
    "\n",
    "scaler_reg = StandardScaler()\n",
    "X_train_r = scaler_reg.fit_transform(X_train)\n",
    "X_test_r = scaler_reg.transform(X_test)\n",
    "\n",
    "# Сравнение моделей регрессии\n",
    "from sklearn.linear_model import Ridge, Lasso\n",
    "from sklearn.ensemble import RandomForestRegressor\n",
    "import xgboost as xgb\n",
    "\n",
    "models_reg = {\n",
    "    'Ridge': Ridge(alpha=1.0),\n",
    "    'Lasso': Lasso(alpha=0.1, max_iter=2000),\n",
    "    'XGBoost': xgb.XGBRegressor(n_estimators=100, max_depth=5, learning_rate=0.1, random_state=42, n_jobs=-1),\n",
    "}\n",
    "\n",
    "print(\"Сравнение моделей регрессии:\")\n",
    "print(\"=\" * 50)\n",
    "results_reg = {}\n",
    "for name, model in models_reg.items():\n",
    "    model.fit(X_train_r, y_train_r)\n",
    "    y_pred = model.predict(X_test_r)\n",
    "    mae = mean_absolute_error(y_test_r, y_pred)\n",
    "    rmse = np.sqrt(mean_squared_error(y_test_r, y_pred))\n",
    "    r2 = r2_score(y_test_r, y_pred)\n",
    "    results_reg[name] = {'MAE': mae, 'RMSE': rmse, 'R2': r2}\n",
    "    print(f\"{name:15s} MAE={mae:>10,.0f}  RMSE={rmse:>10,.0f}  R²={r2:.4f}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Визуализация предсказаний лучшей модели\n",
    "best_model_name = min(results_reg, key=lambda k: results_reg[k]['MAE'])\n",
    "best_model = models_reg[best_model_name]\n",
    "y_pred_best = best_model.predict(X_test_r)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    # Predicted vs Actual
    "axes[0].scatter(y_test_r, y_pred_best, alpha=0.3, s=10)\n",
    "axes[0].plot([y_test_r.min(), y_test_r.max()], [y_test_r.min(), y_test_r.max()], 'r--', linewidth=2)\n",
    "axes[0].set_xlabel('Фактическая сумма')\n",
    "axes[0].set_ylabel('Предсказанная сумма')\n",
    "axes[0].set_title(f'{best_model_name}: Predicted vs Actual')\n",
    "\n",
    # Residuals
    "residuals = y_test_r - y_pred_best\n",
    "axes[1].hist(residuals, bins=50, edgecolor='black', alpha=0.7)\n",
    "axes[1].set_xlabel('Остаток (факт - предсказание)')\n",
    "axes[1].set_ylabel('Частота')\n",
    "axes[1].set_title('Распределение остатков')\n",
    "axes[1].axvline(0, color='red', linestyle='--')\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Задача классификации: предсказание дефолта"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "X_train, X_test, y_train_c, y_test_c = train_test_split(\n",
    "    X, y_class, test_size=0.25, random_state=42, stratify=y_class\n",
    ")\n",
    "\n",
    "scaler_cls = StandardScaler()\n",
    "X_train_c = scaler_cls.fit_transform(X_train)\n",
    "X_test_c = scaler_cls.transform(X_test)\n",
    "\n",
    "print(f\"Train: {X_train_c.shape}, default rate: {y_train_c.mean():.2%}\")\n",
    "print(f\"Test:  {X_test_c.shape}, default rate: {y_test_c.mean():.2%}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Балансировка через class_weight ===\n",
    "from sklearn.utils.class_weight import compute_sample_weight\n",
    "\n",
    "gb_model = GradientBoostingClassifier(\n",
    "    n_estimators=200,\n",
    "    max_depth=4,\n",
    "    learning_rate=0.05,\n",
    "    min_samples_leaf=50,\n",
    "    subsample=0.8,\n",
    "    random_state=42,\n",
    ")\n",
    "\n",
    "sample_weights = compute_sample_weight('balanced', y_train_c)\n",
    "gb_model.fit(X_train_c, y_train_c, sample_weight=sample_weights)\n",
    "\n",
    "y_proba = gb_model.predict_proba(X_test_c)[:, 1]\n",
    "y_pred = (y_proba >= 0.5).astype(int)\n",
    "\n",
    "print(f\"ROC-AUC: {roc_auc_score(y_test_c, y_proba):.4f}\")\n",
    "print(classification_report(y_test_c, y_pred, target_names=['Paid', 'Default']))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Бизнес-стоимость ошибок при разных порогах ===\n",
    "from sklearn.metrics import precision_recall_curve\n",
    "\n",
    "avg_credit = df['AMT_CREDIT'].mean()\n",
    "cost_default = avg_credit  # FN: теряем весь кредит\n",
    "cost_lost_client = avg_credit * 0.05  # FP: упущенная прибыль 5%\n",
    "\n",
    "thresholds = np.arange(0.05, 0.95, 0.02)\n",
    "results = []\n",
    "\n",
    "for t in thresholds:\n",
    "    y_pred_t = (y_proba >= t).astype(int)\n",
    "    cm = confusion_matrix(y_test_c, y_pred_t)\n",
    "    tn, fp, fn, tp = cm.ravel()\n",
    "    cost = fp * cost_lost_client + fn * cost_default\n",
    "    recall = tp / (tp + fn) if (tp + fn) > 0 else 0\n",
    "    precision = tp / (tp + fp) if (tp + fp) > 0 else 0\n",
    "    results.append({'threshold': t, 'cost': cost, 'precision': precision, 'recall': recall})\n",
    "\n",
    "results_df = pd.DataFrame(results)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "fig, ax1 = plt.subplots(figsize=(12, 6))\n",
    "\n",
    "color1 = 'steelblue'\n",
    "ax1.set_xlabel('Порог вероятности дефолта')\n",
    "ax1.set_ylabel('Стоимость ошибок ($)', color=color1)\n",
    "ax1.plot(results_df['threshold'], results_df['cost'], color=color1, linewidth=2, label='Стоимость ошибок')\n",
    "ax1.tick_params(axis='y', labelcolor=color1)\n",
    "\n",
    "best_idx = results_df['cost'].idxmin()\n",
    "best_threshold = results_df.loc[best_idx, 'threshold']\n",
    "best_cost = results_df.loc[best_idx, 'cost']\n",
    "ax1.axvline(best_threshold, color='red', linestyle='--', label=f'Оптимум: t={best_threshold:.2f}')\n",
    "\n",
    "ax2 = ax1.twinx()\n",
    "color2 = 'darkorange'\n",
    "ax2.set_ylabel('Precision / Recall', color=color2)\n",
    "ax2.plot(results_df['threshold'], results_df['precision'], color=color2, linestyle='-', label='Precision')\n",
    "ax2.plot(results_df['threshold'], results_df['recall'], color='green', linestyle='-', label='Recall')\n",
    "ax2.tick_params(axis='y', labelcolor=color2)\n",
    "\n",
    "plt.title('Стоимость ошибок vs Precision/Recall при разных порогах')\n",
    "fig.legend(loc='upper right', bbox_to_anchor=(0.9, 0.9))\n",
    "plt.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "print(f\"Оптимальный порог: {best_threshold:.2f}\")\n",
    "print(f\"Минимальная стоимость ошибок: ${best_cost:,.0f}\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Сравнение моделей классификации"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import xgboost as xgb\n",
    "import lightgbm as lgb\n",
    "\n",
    "models_cls = {\n",
    "    'Logistic Regression': LogisticRegression(max_iter=1000, random_state=42, class_weight='balanced'),\n",
    "    'Gradient Boosting': GradientBoostingClassifier(n_estimators=100, max_depth=4, random_state=42),\n",
    "    'XGBoost': xgb.XGBClassifier(n_estimators=200, max_depth=5, learning_rate=0.05,\n",
