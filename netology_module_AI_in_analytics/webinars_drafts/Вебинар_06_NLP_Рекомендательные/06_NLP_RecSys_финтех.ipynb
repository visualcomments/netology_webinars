    "# === Hybrid: CF + Content-Based ===\n",
    "def hybrid_recommendations(user_id, n_recs=10, alpha=0.5):\n",
    "    user_idx = user_id - 1\n",
    "    if user_idx >= len(user_factors):\n",
    "        return []\n",
    "    \n",
    "    user_rated = set(np.where(user_item.values[user_idx] > 0)[0])\n",
    "    \n",
    "    # CF score\n",
    "    cf_scores = predicted_ratings[user_idx]\n",
    "    \n",
    "    # Content-based: средний профиль пользователя на основе его оценок\n",
    "    user_profile = np.zeros(item_features.shape[1])\n",
    "    n_rated = 0\n",
    "    for movie_idx, rating in enumerate(user_item.values[user_idx]):\n",
    "        if rating > 0:\n",
    "            user_profile += item_features[movie_idx] * rating\n",
    "            n_rated += 1\n",
    "    \n",
    "    if n_rated > 0:\n",
    "        user_profile /= n_rated\n",
    "    \n",
    "    # CB score: косинусное сходство с профилем\n",
    "    cb_scores = item_features @ user_profile / (np.linalg.norm(item_features, axis=1) * np.linalg.norm(user_profile) + 1e-8)\n",
    "    \n",
    "    # Нормализация\n",
    "    cf_min, cf_max = cf_scores[cf_scores > -np.inf].min(), cf_scores[cf_scores > -np.inf].max()\n",
    "    cb_min, cb_max = cb_scores.min(), cb_scores.max()\n",
    "    \n",
    "    cf_norm = (cf_scores - cf_min) / (cf_max - cf_min + 1e-8)\n",
    "    cb_norm = (cb_scores - cb_min) / (cb_max - cb_min + 1e-8)\n",
    "    \n",
    "    hybrid = alpha * cf_norm + (1 - alpha) * cb_norm\n",
    "    \n",
    "    # Исключаем просмотренные\n",
    "    for m in user_rated:\n",
    "        hybrid[m] = -np.inf\n",
    "    \n",
    "    top_indices = np.argsort(-hybrid)[:n_recs]\n",
    "    movie_ids = user_item.columns[top_indices]\n",
    "    \n",
    "    recommended = movies[movies['movieId'].isin(movie_ids)][['movieId', 'title', 'genres']].copy()\n",
    "    recommended['hybrid_score'] = hybrid[top_indices]\n",
    "    return recommended.sort_values('hybrid_score', ascending=False)\n",
    "\n",
    "recs_hybrid = hybrid_recommendations(user_id=1, n_recs=10, alpha=0.7)\n",
    "print(\"Hybrid рекомендации для пользователя 1:\")\n",
    "print(recs_hybrid)"
   ]
