   "source": [
    "# Вебинар 6: NLP и Рекомендательные системы в финтехе\n",
    "\n",
    "## 📊 Датасет 1: Sentiment Analysis\n",
    "**Название:** [Financial Phrase Bank](https://www.kaggle.com/datasets/ankurzing/sentiment-analysis-for-financial-news)  \n",
    "**Описание:** 4840 финансовых новостей с разметкой тональности (positive/neutral/negative).  \n",
    "**Задача:** Классификация тональности финансовых новостей.\n",
    "\n",
    "## 📊 Датасет 2: Рекомендательные системы\n",
    "**Название:** [MovieLens 1M](https://www.kaggle.com/datasets/odedgolden/movielens-1m-dataset)  \n",
    "**Описание:** 1 млн оценок фильмов от 6000 пользователей по 4000 фильмам.  \n",
    "**Задача:** Рекомендация фильмов (аналогия с финансовыми продуктами).\n",
    "\n",
    "## 🎯 Цели ноутбука\n",
    "1. Построить sentiment classifier с accuracy > 0.8\n",
    "2. Тематическое моделирование (LDA)\n",
    "3. Построить рекомендательную систему (CF + content-based)\n",
    "4. Оценить качество рекомендаций (Precision@K, NDCG)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Часть 1: Sentiment Analysis финансовых новостей"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import numpy as np\n",
    "import pandas as pd\n",
    "import re\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "import warnings\n",
    "warnings.filterwarnings('ignore')\n",
    "\n",
    "from sklearn.model_selection import train_test_split\n",
    "from sklearn.feature_extraction.text import TfidfVectorizer, CountVectorizer\n",
    "from sklearn.linear_model import LogisticRegression\n",
    "from sklearn.svm import SVC\n",
    "from sklearn.ensemble import RandomForestClassifier\n",
    "from sklearn.metrics import classification_report, accuracy_score, confusion_matrix\n",
    "from sklearn.decomposition import LatentDirichletAllocation\n",
    "from collections import Counter\n",
    "\n",
    "import os\n",
    "for dirname, _, filenames in os.walk('/kaggle/input'):\n",
    "    for filename in filenames:\n",
    "        print(os.path.join(dirname, filename))"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Загружаем датасет\n",
    "# Обычно файл называется all-data.csv или FinancialPhraseBank.csv\n",
    "import glob\n",
    "\n",
    "files = glob.glob('/kaggle/input/**/all-data.csv', recursive=True)\n",
    "if not files:\n",
    "    files = glob.glob('/kaggle/input/**/FinancialPhraseBank*.csv', recursive=True)\n",
    "if not files:\n",
    "    files = glob.glob('/kaggle/input/**/sentiment*.csv', recursive=True)\n",
    "\n",
    "print(f\"Найдены файлы: {files}\")\n",
    "\n",
    "if files:\n",
    "    df_sent = pd.read_csv(files[0], encoding='latin-1', names=['sentiment', 'text'])\n",
    "else:\n",
    "    # Создаём синтетический датасет, если не найден\n",
    "    print(\"Создаём синтетический датасет финансовых новостей\")\n",
    "    np.random.seed(42)\n",
    "    \n",
    "    positive_templates = [\n",
    "        \"Company {co} reports strong quarterly earnings, beating expectations\",\n",
    "        \"{co} stock surges on positive outlook for next fiscal year\",\n",
    "        \"Analysts upgrade {co} to buy rating citing strong growth\",\n",
    "        \"{co} announces dividend increase, shares rise on news\",\n",
    "        \"Record profits for {co} in {q} quarter, exceeding forecasts\",\n",
    "        \"{co} receives regulatory approval for new product line\",\n",
    "        \"Strong demand drives {co} revenue up 15 percent year over year\",\n",
    "        \"{co} expands operations to new markets, creating 500 new jobs\",\n",
    "    ]\n",
    "    \n",
    "    negative_templates = [\n",
    "        \"{co} shares plunge after disappointing earnings report\",\n",
    "        \"{co} faces lawsuit over alleged accounting irregularities\",\n",
    "        \"Analysts downgrade {co} amid concerns about debt levels\",\n",
    "        \"{co} misses revenue estimates, cuts full year guidance\",\n",
    "        \"Major customer loss weighs on {co} third quarter results\",\n",
    "        \"{co} CEO resigns amid investigation into misconduct\",\n",
    "        \"Regulatory probe into {co} business practices announced today\",\n",
    "        \"{co} stock hits 52 week low on profit warning\",\n",
    "    ]\n",
    "    \n",
    "    neutral_templates = [\n",
    "        \"{co} to release quarterly results next week\",\n",
    "        \"{co} appoints new board member effective immediately\",\n",
    "        \"Analysts maintain hold rating on {co} shares\",\n",
    "        \"{co} announces annual shareholders meeting date\",\n",
    "        \"{co} files quarterly report with securities regulator\",\n",
    "        \"Company {co} to present at industry conference\",\n",
    "        \"{co} completes previously announced acquisition\",\n",
    "        \"{co} updates corporate governance policies\",\n",
    "    ]\n",
    "    \n",
    "    companies = ['Acme Corp', 'Beta Industries', 'Gamma Holdings', 'Delta Bank',\n",
    "                 'Epsilon Tech', 'Zeta Energy', 'Theta Pharma', 'Iota Finance']\n",
    "    quarters = ['first', 'second', 'third', 'fourth']\n",
    "    \n",
    "    data = []\n",
    "    for template, sentiment in [(positive_templates, 'positive'), \n",
    "                                (negative_templates, 'negative'),\n",
    "                                (neutral_templates, 'neutral')]:\n",
    "        for _ in range(300):\n",
    "            t = np.random.choice(template)\n",
    "            co = np.random.choice(companies)\n",
    "            q = np.random.choice(quarters)\n",
    "            data.append({'sentiment': sentiment, 'text': t.format(co=co, q=q)})\n",
    "    \n",
    "    df_sent = pd.DataFrame(data)\n",
    "\n",
    "print(f\"\\nРазмер: {df_sent.shape}\")\n",
    "print(f\"\\nРаспределение:\")\n",
    "print(df_sent['sentiment'].value_counts())\n",
    "print(f\"\\nПримеры:\")\n",
    "print(df_sent.head())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Предобработка ===\n",
    "def preprocess_text(text):\n",
    "    text = text.lower()\n",
    "    text = re.sub(r'[^a-z\\s]', ' ', text)\n",
    "    text = re.sub(r'\\s+', ' ', text).strip()\n",
    "    return text\n",
    "\n",
    "df_sent['clean_text'] = df_sent['text'].apply(preprocess_text)\n",
    "df_sent['text_length'] = df_sent['clean_text'].str.len()\n",
    "\n",
    "print(\"Статистика по длине текста:\")\n",
    "print(df_sent.groupby('sentiment')['text_length'].describe())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === TF-IDF + классификация ===\n",
    "X = df_sent['clean_text']\n",
    "y = df_sent['sentiment']\n",
    "\n",
    "X_train, X_test, y_train, y_test = train_test_split(\n",
    "    X, y, test_size=0.25, random_state=42, stratify=y\n",
    ")\n",
    "\n",
    "tfidf = TfidfVectorizer(\n",
    "    max_features=2000,\n",
    "    ngram_range=(1, 2),\n",
    "    min_df=2,\n",
    "    max_df=0.95,\n",
    "    sublinear_tf=True\n",
    ")\n",
    "\n",
    "X_train_tfidf = tfidf.fit_transform(X_train)\n",
    "X_test_tfidf = tfidf.transform(X_test)\n",
    "\n",
    "# Сравнение моделей\n",
    "models = {\n",
    "    'Logistic Regression': LogisticRegression(max_iter=1000, random_state=42, C=1.0),\n",
    "    'SVM': SVC(kernel='linear', random_state=42),\n",
    "    'Random Forest': RandomForestClassifier(n_estimators=200, random_state=42, n_jobs=-1),\n",
    "}\n",
    "\n",
    "print(\"Сравнение моделей:\")\n",
    "print(\"=\" * 60)\n",
    "best_model = None\n",
    "best_acc = 0\n",
    "for name, model in models.items():\n",
    "    model.fit(X_train_tfidf, y_train)\n",
    "    y_pred = model.predict(X_test_tfidf)\n",
    "    acc = accuracy_score(y_test, y_pred)\n",
    "    print(f\"{name:25s} Accuracy: {acc:.4f}\")\n",
    "    if acc > best_acc:\n",
    "        best_acc = acc\n",
    "        best_model = model"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Детальный отчёт\n",
    "y_pred_best = best_model.predict(X_test_tfidf)\n",
    "print(classification_report(y_test, y_pred_best))\n",
    "\n",
    "# Матрица ошибок\n",
    "cm = confusion_matrix(y_test, y_pred_best, labels=['positive', 'neutral', 'negative'])\n",
    "plt.figure(figsize=(8, 6))\n",
    "sns.heatmap(cm, annot=True, fmt='d', cmap='Blues',\n",
    "            xticklabels=['positive', 'neutral', 'negative'],\n",
    "            yticklabels=['positive', 'neutral', 'negative'])\n",
    "plt.title('Confusion Matrix')\n",
    "plt.ylabel('True')\n",
    "plt.xlabel('Predicted')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Важные слова для каждого класса ===\n",
    "if hasattr(best_model, 'coef_'):\n",
    "    feature_names = tfidf.get_feature_names_out()\n",
    "    classes = best_model.classes_\n",
    "    \n",
    "    fig, axes = plt.subplots(1, 3, figsize=(20, 5))\n",
    "    for i, cls in enumerate(classes):\n",
    "        coef = best_model.coef_[i]\n",
    "        top_words = sorted(zip(feature_names, coef), key=lambda x: -x[1])[:10]\n",
    "        words, scores = zip(*top_words)\n",
    "        \n",
    "        axes[i].barh(range(len(words)), scores, color=['green' if cls=='positive' else 'red' if cls=='negative' else 'gray'][0])\n",
    "        axes[i].set_yticks(range(len(words)))\n",
    "        axes[i].set_yticklabels(words)\n",
    "        axes[i].invert_yaxis()\n",
    "        axes[i].set_title(f'Класс: {cls}')\n",
    "        axes[i].set_xlabel('Коэффициент')\n",
    "    plt.tight_layout()\n",
    "    plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Тематическое моделирование (LDA)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# CountVectorizer для LDA\n",
    "count_vec = CountVectorizer(\n",
    "    max_features=500,\n",
    "    min_df=2,\n",
    "    max_df=0.95,\n",
    "    stop_words='english'\n",
    ")\n",
    "\n",
    "X_counts = count_vec.fit_transform(df_sent['clean_text'])\n",
    "feature_names = count_vec.get_feature_names_out()\n",
    "\n",
    "n_topics = 4\n",
    "lda = LatentDirichletAllocation(n_components=n_topics, random_state=42, max_iter=20)\n",
    "lda.fit(X_counts)\n",
    "\n",
    "print(\"Темы в финансовых новостях:\")\n",
    "print(\"=\" * 60)\n",
    "for topic_idx, topic in enumerate(lda.components_):\n",
    "    top_words = [feature_names[i] for i in topic.argsort()[:-8 - 1:-1]]\n",
    "    print(f\"\\nТема {topic_idx + 1}: {', '.join(top_words)}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Распределение тем\n",
    "topic_dist = lda.transform(X_counts)\n",
    "df_sent['dominant_topic'] = topic_dist.argmax(axis=1)\n",
    "\n",
    "fig, axes = plt.subplots(1, 2, figsize=(14, 5))\n",
    "\n",
    "topic_counts = df_sent['dominant_topic'].value_counts().sort_index()\n",
    "axes[0].bar(topic_counts.index, topic_counts.values, color='steelblue')\n",
    "axes[0].set_xlabel('Тема')\n",
    "axes[0].set_ylabel('Количество новостей')\n",
    "axes[0].set_title('Распределение тем')\n",
    "axes[0].grid(alpha=0.3)\n",
    "\n",
    "# Связь темы и сентимента\n",
    "topic_sent = pd.crosstab(df_sent['dominant_topic'], df_sent['sentiment'], normalize='index')\n",
    "topic_sent.plot(kind='bar', stacked=True, ax=axes[1], colormap='RdYlGn')\n",
    "axes[1].set_title('Распределение сентимента по темам')\n",
    "axes[1].set_xlabel('Тема')\n",
    "axes[1].set_ylabel('Доля')\n",
    "axes[1].legend(title='Sentiment')\n",
    "axes[1].tick_params(axis='x', rotation=0)\n",
    "\n",
    "plt.tight_layout()\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## Часть 2: Рекомендательные системы (MovieLens)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from sklearn.decomposition import TruncatedSVD\n",
    "from sklearn.metrics.pairwise import cosine_similarity\n",
    "from sklearn.neighbors import NearestNeighbors\n",
    "\n",
    "# Загружаем MovieLens 1M (или другой доступный)\n",
    "import glob\n",
    "files = glob.glob('/kaggle/input/**/ratings*.csv', recursive=True)\n",
    "if not files:\n",
    "    files = glob.glob('/kaggle/input/**/movies*.csv', recursive=True)\n",
    "\n",
    "if files:\n",
    "    # Загружаем данные MovieLens\n",
    "    ratings_file = glob.glob('/kaggle/input/**/ratings*.csv', recursive=True)\n",
    "    movies_file = glob.glob('/kaggle/input/**/movies*.csv', recursive=True)\n",
    "    \n",
    "    if ratings_file and movies_file:\n",
    "        # Определяем формат\n",
    "        if 'ml-1m' in ratings_file[0] or '1m' in ratings_file[0]:\n",
    "            ratings = pd.read_csv(ratings_file[0], sep='::', engine='python', \n",
    "                                  names=['userId', 'movieId', 'rating', 'timestamp'])\n",
    "            movies = pd.read_csv(movies_file[0], sep='::', engine='python',\n",
    "                                 names=['movieId', 'title', 'genres'], encoding='latin-1')\n",
    "        else:\n",
    "            ratings = pd.read_csv(ratings_file[0])\n",
    "            movies = pd.read_csv(movies_file[0])\n",
    "        \n",
    "        print(f\"Ratings: {ratings.shape}\")\n",
    "        print(f\"Movies: {movies.shape}\")\n",
    "    else:\n",
    "        ratings = None\n",
    "else:\n",
    "    ratings = None\n",
    "\n",
    "if ratings is None or len(ratings) == 0:\n",
    "    print(\"MovieLens не найден, генерируем синтетические данные\")\n",
    "    np.random.seed(42)\n",
    "    n_users = 1000\n",
    "    n_movies = 500\n",
    "    \n",
    "    data = []\n",
    "    for user in range(1, n_users + 1):\n",
    "        n_ratings = np.random.poisson(30)\n",
    "        movies_rated = np.random.choice(range(1, n_movies + 1), size=n_ratings, replace=False)\n",
    "        for movie in movies_rated:\n",
    "            # Имитация предпочтений (жанр)\n",
    "            rating = np.random.choice([1,2,3,4,5], p=[0.05, 0.1, 0.2, 0.35, 0.3])\n",
    "            data.append({'userId': user, 'movieId': movie, 'rating': rating, 'timestamp': 0})\n",
    "    ratings = pd.DataFrame(data)\n",
    "    \n",
    "    # Синтетические фильмы\n",
    "    movies = pd.DataFrame({\n",
    "        'movieId': range(1, n_movies + 1),\n",
    "        'title': [f'Movie {i}' for i in range(1, n_movies + 1)],\n",
    "        'genres': np.random.choice(['Action', 'Comedy', 'Drama', 'Sci-Fi'], n_movies)\n",
    "    })\n",
    "\n",
    "print(f\"\\nRatings sample:\")\n",
    "print(ratings.head())\n",
    "print(f\"\\nMovies sample:\")\n",
    "print(movies.head())"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Создаём user-item матрицу\n",
    "user_item = ratings.pivot_table(index='userId', columns='movieId', values='rating', fill_value=0)\n",
    "print(f\"Матрица user-item: {user_item.shape}\")\n",
    "print(f\"Плотность: {(user_item != 0).sum().sum() / (user_item.shape[0] * user_item.shape[1]):.2%}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Collaborative Filtering: SVD ===\n",
    "n_components = 50\n",
    "svd = TruncatedSVD(n_components=n_components, random_state=42)\n",
    "user_factors = svd.fit_transform(user_item.values)\n",
    "item_factors = svd.components_.T\n",
    "\n",
    "print(f\"User factors: {user_factors.shape}\")\n",
    "print(f\"Item factors: {item_factors.shape}\")\n",
    "print(f\"Объяснённая дисперсия: {svd.explained_variance_ratio_.sum():.2%}\")\n",
    "\n",
    "# Предсказания: user x item матрица\n",
    "predicted_ratings = user_factors @ item_factors.T\n",
    "print(f\"\\nPredicted ratings shape: {predicted_ratings.shape}\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Рекомендации для пользователя ===\n",
    "def get_recommendations_cf(user_id, n_recs=10):\n",
    "    \"\"\"Top-N рекомендаций для пользователя\"\"\"\n",
    "    user_idx = user_id - 1  # 0-based\n",
    "    if user_idx >= len(user_factors):\n",
    "        return []\n",
    "    \n",
    "    user_rated = set(np.where(user_item.values[user_idx] > 0)[0])\n",
    "    \n",
    "    # Scores для всех фильмов\n",
    "    scores = predicted_ratings[user_idx]\n",
    "    # Исключаем уже просмотренные\n",
    "    for movie_idx in user_rated:\n",
    "        scores[movie_idx] = -np.inf\n",
    "    \n",
    "    top_indices = np.argsort(-scores)[:n_recs]\n",
    "    \n",
    "    # Перевод в movieId\n",
    "    movie_ids = user_item.columns[top_indices]\n",
    "    recommended = movies[movies['movieId'].isin(movie_ids)][['movieId', 'title', 'genres']].copy()\n",
    "    recommended['predicted_rating'] = scores[top_indices]\n",
    "    return recommended.sort_values('predicted_rating', ascending=False)\n",
    "\n",
    "recs = get_recommendations_cf(user_id=1, n_recs=10)\n",
    "print(\"Рекомендации для пользователя 1:\")\n",
    "print(recs)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Оценка: Precision@K, Recall@K ===\n",
    "def evaluate_recommendations(predicted_ratings, user_item_matrix, n_test=5, k=10, n_users_eval=200):\n",
    "    \"\"\"Скрываем последние n_test оценок и проверяем рекомендации\"\"\"\n",
    "    np.random.seed(42)\n",
    "    user_indices = np.random.choice(user_item_matrix.shape[0], n_users_eval, replace=False)\n",
    "    \n",
    "    precisions = []\n",
    "    recalls = []\n",
    "    \n",
    "    for user_idx in user_indices:\n",
    "        user_ratings = user_item_matrix.values[user_idx]\n",
    "        rated_movies = np.where(user_ratings > 0)[0]\n",
    "        \n",
    "        if len(rated_movies) < n_test + 1:\n",
    "            continue\n",
    "        \n",
    "        # Скрываем n_test случайных фильмов\n",
    "        test_movies = np.random.choice(rated_movies, n_test, replace=False)\n",
    "        train_ratings = user_ratings.copy()\n",
    "        train_ratings[test_movies] = 0\n",
    "        \n",
    "        # Предсказываем\n",
    "        scores = predicted_ratings[user_idx].copy()\n",
    "        scores[test_movies] = -np.inf\n",
    "        for m in rated_movies:\n",
    "            if m not in test_movies:\n",
    "                scores[m] = -np.inf\n",
    "        \n",
    "        top_k = np.argsort(-scores)[:k]\n",
    "        hits = len(set(top_k) & set(test_movies))\n",
    "        \n",
    "        precisions.append(hits / k)\n",
    "        recalls.append(hits / len(test_movies))\n",
    "    \n",
    "    return np.mean(precisions), np.mean(recalls)\n",
    "\n",
    "p, r = evaluate_recommendations(predicted_ratings, user_item, k=10, n_users_eval=100)\n",
    "print(f\"Precision@10: {p:.4f}\")\n",
    "print(f\"Recall@10:    {r:.4f}\")"
