   "source": [
    "## 5. Multi-Asset Portfolio с RL"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class MultiAssetEnv:\n",
    "    \"\"\"Среда для управления портфелем из нескольких активов\"\"\"\n",
    "    \n",
    "    def __init__(self, prices_df, window=20, initial_capital=10000, rebalance_period=5):\n",
    "        self.prices = prices_df.values\n",
    "        self.tickers = prices_df.columns.tolist()\n",
    "        self.n_assets = len(self.tickers)\n",
    "        self.window = window\n",
    "        self.initial_capital = initial_capital\n",
    "        self.rebalance_period = rebalance_period\n",
    "        self.reset()\n",
    "    \n",
    "    def reset(self):\n",
    "        self.idx = self.window\n",
    "        self.capital = self.initial_capital\n",
    "        self.weights = np.ones(self.n_assets) / self.n_assets\n",
    "        self.done = False\n",
    "        self.history = []\n",
    "        return self._state()\n",
    "    \n",
    "    def _state(self):\n",
    "        \"\"\"Состояние: returns, vol, текущие веса\"\"\"\n",
    "        if self.idx >= len(self.prices):\n",
    "            return None\n",
    "        \n",
    "        window_prices = self.prices[self.idx - self.window:self.idx + 1]\n",
    "        # Returns за окно\n",
    "        returns = window_prices[-1] / window_prices[0] - 1\n",
    "        # Волатильность\n",
    "        vol = np.std(np.diff(window_prices, axis=0) / window_prices[:-1], axis=0)\n",
    "        # Sharpe-like для портфеля\n",
    "        port_returns = (window_prices[1:] / window_prices[:-1] - 1) @ self.weights\n",
    "        sharpe = port_returns.mean() / (port_returns.std() + 1e-8)\n",
    "        \n",
    "        state = np.concatenate([returns, vol, self.weights, [sharpe]])\n",
    "        return state\n",
    "    \n",
    "    def step(self, new_weights):\n",
    "        if self.done:\n",
    "            return None, 0, True, {}\n",
    "        \n",
    "        # Нормализация\n",
    "        new_weights = np.abs(new_weights)\n",
    "        if new_weights.sum() > 0:\n",
    "            new_weights = new_weights / new_weights.sum()\n",
    "        else:\n",
    "            new_weights = np.ones(self.n_assets) / self.n_assets\n",
    "        \n",
    "        old_value = self.capital\n",
    "        \n",
    "        # Доходность за период\n",
    "        start = self.idx\n",
    "        end = min(self.idx + self.rebalance_period, len(self.prices) - 1)\n",
    "        period_return = (self.prices[end] / self.prices[start] - 1) @ new_weights\n",
    "        \n",
    "        # Transaction costs\n",
    "        turnover = np.sum(np.abs(new_weights - self.weights))\n",
    "        tc = turnover * 0.001\n",
    "        \n",
    "        self.capital *= (1 + period_return - tc)\n",
    "        self.weights = new_weights\n",
    "        self.idx = end\n",
    "        \n",
    "        self.history.append(self.capital)\n",
    "        if self.idx >= len(self.prices) - 1:\n",
    "            self.done = True\n",
    "        \n",
    "        reward = (self.capital - old_value) / old_value\n",
    "        return self._state(), reward, self.done, {}\n",
    "    \n",
    "    def get_final_value(self):\n",
    "        return self.capital"
   ]
