   "source": [
    "## 3. Q-Learning агент"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "from collections import defaultdict\n",
    "\n",
    "class QLearningAgent:\n",
    "    def __init__(self, n_actions=3, learning_rate=0.1, discount=0.95, \n",
    "                 epsilon=1.0, epsilon_decay=0.995, epsilon_min=0.05):\n",
    "        self.n_actions = n_actions\n",
    "        self.lr = learning_rate\n",
    "        self.discount = discount\n",
    "        self.epsilon = epsilon\n",
    "        self.epsilon_decay = epsilon_decay\n",
    "        self.epsilon_min = epsilon_min\n",
    "        self.q_table = defaultdict(lambda: np.zeros(n_actions))\n",
    "    \n",
    "    def discretize_state(self, state, bins=10):\n",
    "        \"\"\"Дискретизация непрерывного состояния\"\"\"\n",
    "        discretized = []\n",
    "        for val in state:\n",
    "            bin_idx = int((val + 1) / 2 * bins)\n",
    "            bin_idx = max(0, min(bin_idx, bins - 1))\n",
    "            discretized.append(bin_idx)\n",
    "        return tuple(discretized)\n",
    "    \n",
    "    def choose_action(self, state):\n",
    "        if np.random.random() < self.epsilon:\n",
    "            return np.random.randint(self.n_actions)\n",
    "        state_key = self.discretize_state(state)\n",
    "        return np.argmax(self.q_table[state_key])\n",
    "    \n",
    "    def update(self, state, action, reward, next_state, done):\n",
    "        state_key = self.discretize_state(state)\n",
    "        if done or next_state is None:\n",
    "            target = reward\n",
    "        else:\n",
    "            next_state_key = self.discretize_state(next_state)\n",
    "            target = reward + self.discount * np.max(self.q_table[next_state_key])\n",
    "        \n",
    "        self.q_table[state_key][action] += self.lr * (target - self.q_table[state_key][action])\n",
    "    \n",
    "    def decay_epsilon(self):\n",
    "        self.epsilon = max(self.epsilon * self.epsilon_decay, self.epsilon_min)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Обучение ===\n",
    "agent = QLearningAgent(learning_rate=0.1, discount=0.95, epsilon=1.0)\n",
    "\n",
    "n_episodes = 500\n",
    "history = {'rewards': [], 'values': [], 'epsilons': []}\n",
    "\n",
    "for episode in range(n_episodes):\n",
    "    env = TradingEnvironment(prices)\n",
    "    state = env.reset()\n",
    "    total_reward = 0\n",
    "    \n",
    "    while not env.done:\n",
    "        action = agent.choose_action(state)\n",
    "        next_state, reward, done, _ = env.step(action)\n",
    "        \n",
    "        if next_state is not None:\n",
    "            agent.update(state, action, reward, next_state, done)\n",
    "        \n",
    "        total_reward += reward\n",
    "        state = next_state\n",
    "    \n",
    "    agent.decay_epsilon()\n",
    "    final_value = env.get_final_value()\n",
    "    history['rewards'].append(total_reward)\n",
    "    history['values'].append(final_value)\n",
    "    history['epsilons'].append(agent.epsilon)\n",
    "    \n",
    "    if (episode + 1) % 50 == 0:\n",
    "        avg_value = np.mean(history['values'][-50:])\n",
    "        avg_reward = np.mean(history['rewards'][-50:])\n",
    "        print(f\"Episode {episode+1}/{n_episodes} | Avg Reward: {avg_reward:.4f} | \"\n",
    "              f\"Avg Value: ${avg_value:,.0f} | Epsilon: {agent.epsilon:.3f}\")"
   ]
  },
  {
