   "source": [
    "## 2. Торговая среда"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "class TradingEnvironment:\n",
    "    \"\"\"Gym-like среда для торговли одной акцией\"\"\"\n",
    "    \n",
    "    def __init__(self, prices, window_size=10, initial_cash=10000, commission=0.001):\n",
    "        self.prices = prices\n",
    "        self.window_size = window_size\n",
    "        self.initial_cash = initial_cash\n",
    "        self.commission = commission\n",
    "        self.reset()\n",
    "    \n",
    "    def reset(self):\n",
    "        self.step_idx = self.window_size\n",
    "        self.cash = self.initial_cash\n",
    "        self.shares = 0\n",
    "        self.done = False\n",
    "        self.trade_history = []\n",
    "        return self._get_state()\n",
    "    \n",
    "    def _get_state(self):\n",
    "        \"\"\"Состояние: технические индикаторы\"\"\"\n",
    "        if self.step_idx >= len(self.prices) - 1:\n",
    "            return None\n",
    "        \n",
    "        window = self.prices[self.step_idx - self.window_size:self.step_idx + 1]\n",
    "        \n",
    "        # Нормализация: относительно текущей цены\n",
    "        current_price = window[-1]\n",
    "        norm_window = window / current_price - 1\n",
    "        \n",
    "        # Дополнительные признаки\n",
    "        sma = np.mean(window)\n",
    "        momentum = (window[-1] / window[0]) - 1\n",
    "        volatility = np.std(np.diff(window) / window[:-1])\n",
    "        \n",
    "        # Текущая позиция\n",
    "        position_ratio = self.shares * current_price / (self.cash + self.shares * current_price + 1e-8)\n",
    "        \n",
    "        # Стохастический осциллятор\n",
    "        if window.max() != window.min():\n",
    "            stoch = (current_price - window.min()) / (window.max() - window.min())\n",
    "        else:\n",
    "            stoch = 0.5\n",
    "        \n",
    "        return np.array([\n",
    "            momentum,\n",
    "            volatility,\n",
    "            (current_price / sma) - 1,\n",
    "            stoch,\n",
    "            position_ratio,\n",
    "        ])\n",
    "    \n",
    "    def step(self, action):\n",
    "        \"\"\"\n",
    "        Actions: 0 = Hold, 1 = Buy, 2 = Sell all\n",
    "        \"\"\"\n",
    "        if self.done:\n",
    "            return None, 0, True, {}\n",
    "        \n",
    "        current_price = self.prices[self.step_idx]\n",
    "        prev_value = self.cash + self.shares * current_price\n",
    "        \n",
    "        reward = 0\n",
    "        \n",
    "        if action == 1:  # Buy\n",
    "            max_shares = int(self.cash / (current_price * (1 + self.commission)))\n",
    "            if max_shares > 0:\n",
    "                to_buy = min(max_shares, 50)\n",
    "                cost = to_buy * current_price * (1 + self.commission)\n",
    "                self.cash -= cost\n",
    "                self.shares += to_buy\n",
    "                self.trade_history.append(('BUY', self.step_idx, current_price, to_buy))\n",
    "        \n",
    "        elif action == 2 and self.shares > 0:  # Sell all\n",
    "            revenue = self.shares * current_price * (1 - self.commission)\n",
    "            self.cash += revenue\n",
    "            self.trade_history.append(('SELL', self.step_idx, current_price, self.shares))\n",
    "            self.shares = 0\n",
    "        \n",
    "        self.step_idx += 1\n",
    "        if self.step_idx >= len(self.prices) - 1:\n",
    "            self.done = True\n",
    "        \n",
    "        new_price = self.prices[min(self.step_idx, len(self.prices) - 1)]\n",
    "        new_value = self.cash + self.shares * new_price\n",
    "        reward = (new_value - prev_value) / prev_value  # Нормализованный reward\n",
    "        \n",
    "        return self._get_state(), reward, self.done, {'portfolio_value': new_value}\n",
    "    \n",
    "    def get_final_value(self):\n",
    "        return self.cash + self.shares * self.prices[-1]\n",
    "    \n",
    "    def get_portfolio_history(self):\n",
    "        history = []\n",
    "        cash = self.initial_cash\n",
    "        shares = 0\n",
    "        for i in range(self.window_size, len(self.prices)):\n",
    "            # Восстанавливаем историю по trade_history\n",
    "            price = self.prices[i]\n",
    "            history.append(cash + shares * price)\n",
    "        return history"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# === Тест среды ===\n",
    "ticker = 'AAPL'\n",
    "prices = data[ticker].values\n",
    "print(f\"Торговля {ticker}, {len(prices)} дней\")\n",
    "print(f\"Начальная цена: ${prices[0]:.2f}, Конечная: ${prices[-1]:.2f}\")\n",
    "print(f\"Доходность Buy & Hold: {(prices[-1] / prices[0] - 1) * 100:.1f}%\")\n",
    "\n",
    "env = TradingEnvironment(prices)\n",
    "state = env.reset()\n",
    "print(f\"\\nРазмер состояния: {state.shape}\")\n",
    "print(f\"State: {state}\")"
   ]
