   "source": [
    "class PolicyGradient:\n",
    "    def __init__(self, state_size, n_assets, lr=0.01):\n",
    "        self.n_assets = n_assets\n",
    "        self.lr = lr\n",
    "        self.W = np.random.randn(state_size, n_assets) * 0.1\n",
    "        self.b = np.zeros(n_assets)\n",
    "    \n",
    "    def get_weights(self, state):\n",
    "        logits = state @ self.W + self.b\n",
    "        exp_l = np.exp(logits - logits.max())\n",
    "        return exp_l / exp_l.sum()\n",
    "    \n",
    "    def update(self, state, reward):\n",
    "        weights = self.get_weights(state)\n",
    "        grad = np.outer(state, weights) * reward\n",
    "        self.W += self.lr * grad\n",
    "        self.b += self.lr * weights * reward"
   ]
