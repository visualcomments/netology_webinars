   "source": [
    "## 4. Backtest: RL агент vs Buy & Hold"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Тестируем обученного агента на тестовом периоде (out-of-sample)\n",
    "split_idx = int(len(prices) * 0.7)\n",
    "train_prices = prices[:split_idx]\n",
    "test_prices = prices[split_idx:]\n",
    "\n",
    "print(f\"Train: {len(train_prices)} дней, Test: {len(test_prices)} дней\")\n",
    "\n",
    "# Обучаем только на train\n",
    "agent = QLearningAgent(learning_rate=0.1, discount=0.95, epsilon=1.0)\n",
    "for ep in range(500):\n",
    "    env = TradingEnvironment(train_prices)\n",
    "    state = env.reset()\n",
    "    while not env.done:\n",
    "        action = agent.choose_action(state)\n",
    "        next_state, reward, done, _ = env.step(action)\n",
    "        if next_state is not None:\n",
    "            agent.update(state, action, reward, next_state, done)\n",
    "        state = next_state\n",
    "    agent.decay_epsilon()\n",
    "\n",
    "print(\"Обучение завершено\")"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Тестирование\n",
    "agent.epsilon = 0  # Отключаем exploration\n",
    "env = TradingEnvironment(test_prices)\n",
    "state = env.reset()\n",
    "portfolio_values = []\n",
    "actions_taken = []\n",
    "\n",
    "while not env.done:\n",
    "    portfolio_values.append(env.cash + env.shares * test_prices[env.step_idx])\n",
    "    action = agent.choose_action(state)\n",
    "    actions_taken.append(action)\n",
    "    state, _, done, _ = env.step(action)\n",
    "\n",
    "portfolio_values.append(env.cash + env.shares * test_prices[-1])\n",
    "\n",
    "rl_final = env.get_final_value()\n",
    "buy_hold_final = 10000 * test_prices[-1] / test_prices[10]  # Учитываем window\n",
    "\n",
    "print(f\"\\n=== РЕЗУЛЬТАТЫ (тестовый период) ===\")\n",
    "print(f\"RL агент:   ${rl_final:,.0f} ({(rl_final/10000-1)*100:+.2f}%)\")\n",
    "print(f\"Buy & Hold: ${buy_hold_final:,.0f} ({(buy_hold_final/10000-1)*100:+.2f}%)\")\n",
    "print(f\"\\nЧисло сделок RL: {sum(1 for a in actions_taken if a != 0)}\")\n",
    "print(f\"Действия: Hold={actions_taken.count(0)}, Buy={actions_taken.count(1)}, Sell={actions_taken.count(2)}\")"
   ]
